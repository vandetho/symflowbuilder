{
    "name": "symflowbuilder",
    "version": "1.44.1",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "prisma:generate": "pnpm --filter @symflowbuilder/db prisma:generate",
        "prisma:migrate": "pnpm --filter @symflowbuilder/db prisma:migrate",
        "prisma:seed": "pnpm --filter @symflowbuilder/db prisma:seed",
        "prisma:studio": "pnpm --filter @symflowbuilder/db prisma:studio",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,yaml,yml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@hookform/resolvers": "^5.9.2",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-radio-group": "^1.5.1",
        "@symflowbuilder/db": "workspace:*",
        "@tanstack/react-hotkeys": "^0.9.1",
        "@xyflow/react": "^12.12.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "framer-motion": "^12.43.0",
        "lucide-react": "^1.66.0",
        "next": "^16.4.3",
        "next-auth": "5.0.0-beta.32",
        "react": "19.3.1",
        "react-color": "^2.19.3",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "sonner": "^2.0.8",
        "sugar-high": "^1.3.0",
        "symflow": "^3.5.2",
        "tailwind-merge": "^3.7.0",
        "use-debounce": "^10.1.1",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bcryptjs": "^3.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.43",
        "@types/react": "^19.3.0",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3"
    }
}
